{
  "expo": {
    "name": "Campus Connect",
    "slug": "campus-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campusconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1565d730-4f88-4944-88fd-5bfa0fe51445"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lesliepaulajayi.campusconnect",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lesliepaulajayi.campusconnect",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F4",
          "dark": {
            "backgroundColor": "#161616"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Campus Connect uses your location to show you students nearby on campus while the app is open.",
          "locationAlwaysAndWhenInUsePermission": "Campus Connect uses your location to show you students nearby on campus while the app is open. It does not track you in the background.",
          "locationAlwaysPermission": "Campus Connect uses your location to show you students nearby on campus while the app is open. It does not track you in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Campus Connect uses your photos so you can attach them to posts and set your profile picture.",
          "cameraPermission": "Campus Connect uses your camera so you can capture a photo for a post or your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#161616"
        }
      ],
      "expo-dev-client",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1565d730-4f88-4944-88fd-5bfa0fe51445"
      }
    },
    "owner": "lesliepaul-23"
  }
}
