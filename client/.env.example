# Copy to `.env` and adjust. Vars must be prefixed EXPO_PUBLIC_ to reach the client bundle.

# REST API base URL, including the /api prefix.
# On a simulator, localhost works. On a physical device, use your machine's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Socket.io server URL (no /api). Defaults to API_URL without the /api suffix.
# EXPO_PUBLIC_SOCKET_URL=http://localhost:8000

# Google OAuth web client id (for Google sign-in).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Image uploads (Cloudinary unsigned). Create an unsigned upload preset in your
# Cloudinary dashboard, then set both. Without these, posts are text-only.
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
# EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
