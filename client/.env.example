# ---------------------------------------------------------------------------
# Campus Connect — client (Expo)
#
# Copy to `.env` and fill in. Only keys prefixed EXPO_PUBLIC_ are readable from
# app code; Expo inlines them into the JS bundle at build time, so anything
# here ships to every device. NEVER put a secret (API key with write scope, DB
# password, JWT secret) in this file — those belong in server/.env.
#
# After editing, restart Metro with a cleared cache:  npx expo start -c
# ---------------------------------------------------------------------------

# Base URL of the Express API in server/. Include the /api prefix — server.js
# mounts every router under it (/api/auth, /api/user, /api/events, ...).
#
#   iOS simulator / web ....  http://localhost:8000/api
#   Android emulator .......  http://10.0.2.2:8000/api
#   Physical device ........  http://<your-LAN-IP>:8000/api
#
# A physical device cannot reach `localhost` — that resolves to the phone.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Socket.IO endpoint (server/socket.js). Same host as the API, no /api suffix.
EXPO_PUBLIC_SOCKET_URL=http://localhost:8000

# --- Google Sign-In (expo-auth-session) ------------------------------------
# One OAuth client per platform, from console.cloud.google.com → Credentials.
# Client IDs are public by design; the client *secret* is not used here.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Firebase (firebase pkg is a dependency; src/services/firestore.ts) -----
# Firebase web config is public — access is governed by security rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Feature flags ----------------------------------------------------------
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_ENABLE_GEOFENCING=true

# --- TEMPORARY -------------------------------------------------------------
# Skips onboarding and the whole auth flow and drops straight into the tabs, so
# the app screens can be worked on while sign-up is blocked server-side.
# Set to false (or delete the line) to restore normal routing.
EXPO_PUBLIC_BYPASS_AUTH=false
