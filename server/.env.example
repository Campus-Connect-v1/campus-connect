MONGODB_PASSWORD='your mongodb password'
MONGODB_USER='your mongodb username'
MONGO_URI='your mongodb uri'



DB_HOST='localhost' # or 127.0.0.1

DB_USER='YOUR MAC DATABASE USER'
DB_NAME='YOUR MAC DATABASE NAME'
DB_PASSWORD='PASSWORD'
DB_PORT=8889 #FOR MAC

DB_USER_2='YOUR WINDOWS DATABASE USER'
DB_NAME_2='YOUR WINDOWS DATABASE NAME'
DB_PASSWORD_2='PASSWORD'
DB_PORT_2=3306 #FOR WINDOWS

PORT=8000


# ---- Email -----------------------------------------------------------------
# Transport is chosen by whichever key is set, or forced with MAIL_PROVIDER.
# Most hosts (including Render) block outbound SMTP on 25/465/587, so an HTTPS
# API is required in production. SMTP still works locally.
#
#   brevo  — verifies a single SENDER ADDRESS, so no domain is needed
#   resend — requires a VERIFIED DOMAIN; without one it only delivers to the
#            Resend account owner's own address
#   smtp   — local development
# MAIL_PROVIDER='brevo'
BREVO_API_KEY=''
RESEND_API_KEY=''

# Must be an address verified with the provider above.
EMAIL_FROM='Campus Connect <your@gmail.com>'

# SMTP fallback (local development)
EMAIL_USER='your@gmail.com'
EMAIL_PASSWORD='your app pass word'

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET='your jwt secret'
CLIENT_URL='http://localhost:3000' # or your client app URL, or '*' to allow any origin

# ---- Operator console (app/) -------------------------------------------------
# Powers the plain-English SQL feature at /admin -> Ask. Generated SQL is
# validated server-side (SELECT only, single statement, no DDL, never
# password_hash or otp_code) before it runs. Leave blank to disable the feature.
GROQ_API_KEY=''
# Check https://api.groq.com/openai/v1/models for what your key allows.
GROQ_MODEL='openai/gpt-oss-120b'

# Operator accounts are created with: node scripts/createOperator.js
# There is no sign-up, and the first account created is always an owner.


 REDIS CLOUD CACHING 
REDIS_URL_LOCAL=redis://localhost:6379
REDIS_CLI=redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_CLI_CONN=redis://localhost:6379


# DEBUG LOGGING (PREFERRED NOT)
DOTENV_CONFIG_DEBUG=false
DEBUG=false



# LOGGER 
SUCCESS=green
ERROR=red
WARNING=yellow