NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:3000

# JWT
JWT_SECRET=replace_with_long_random_secret

# MySQL - macOS/default config/db.js path
DB_HOST=localhost
DB_USER=replace_with_mysql_user
DB_NAME=replace_with_mysql_database
DB_PASSWORD=replace_with_mysql_password
DB_PORT=8889

# MySQL - Windows fallback config/db.js path
DB_USER_2=replace_with_windows_mysql_user
DB_NAME_2=replace_with_windows_mysql_database
DB_PASSWORD_2=replace_with_windows_mysql_password
DB_PORT_2=3306

# MongoDB
MONGO_URI=mongodb://localhost:27017/campus_connect
MONGODB_USER=replace_with_mongodb_user_if_needed
MONGODB_PASSWORD=replace_with_mongodb_password_if_needed

# Redis
REDIS_URL=redis://localhost:6379
REDIS_URL_LOCAL=redis://localhost:6379
REDIS_CLI=redis://localhost:6379
REDIS_CLI_CONN=redis://localhost:6379

# Email / Gmail app password
EMAIL_USER=replace_with_sender_email@gmail.com
EMAIL_PASSWORD=replace_with_email_app_password

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_WEB_CLIENT_ID=replace_with_google_web_client_id

# Logging color keys used by helper/logger.js
SUCCESS=green
ERROR=red
WARNING=yellow

# Debug flags
DOTENV_CONFIG_DEBUG=false
DEBUG=false
